PORT=3000

# MySQL is selected when DB_HOST, DB_USER, and DB_NAME are set.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=copper_shores
DB_USER=copper_app
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# Legacy PostgreSQL support remains available when MySQL is not configured.
DATABASE_URL=
PGSSLMODE=

# Required for /admin backup export/import. Use a long random value.
# When set, Library add/edit/delete requests must also send this token.
ADMIN_WRITE_TOKEN=

# JSON remains the zero-configuration local fallback.
JSON_DB_PATH=
